// The workers-sdk formatting options (`workers-sdk/.oxfmtrc.jsonc`).
{
	"printWidth": 80,
	"singleQuote": false,
	"semi": true,
	"useTabs": true,
	"trailingComma": "es5",
	"sortImports": {
		"groups": ["builtin", "external", "parent", "sibling", "index", "type"],
		"newlinesBetween": false,
	},
	"sortTailwindcss": {},
	"sortPackageJson": {},
	// The e2e fixtures keep their templates' formatting, so that they're easy to
	// compare with them.
	"ignorePatterns": ["CHANGELOG.md", "patches/**", "packages/e2e/fixtures/**"],
}
