{
	"name": "rsbuild-plugin-cloudflare",
	"version": "0.0.2",
	"description": "Cloudflare plugin for Rsbuild (experimental)",
	"keywords": [
		"cloudflare",
		"cloudflare-workers",
		"rsbuild",
		"rsbuild-plugin",
		"rspack",
		"workers"
	],
	"homepage": "https://github.com/james-elicx/rsbuild-plugin-cloudflare#readme",
	"bugs": {
		"url": "https://github.com/james-elicx/rsbuild-plugin-cloudflare/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/james-elicx/rsbuild-plugin-cloudflare.git",
		"directory": "packages/rsbuild-plugin"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"check:type": "tsc",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:ci": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@cloudflare/build-output-utils": "0.9.6",
		"@cloudflare/config": "0.29.0",
		"@cloudflare/runtime-types": "0.1.19",
		"@cloudflare/unenv-preset": "2.16.2",
		"miniflare": "5.20261023.3-beta",
		"unenv": "2.0.0-rc.24",
		"ws": "8.21.0"
	},
	"devDependencies": {
		"@cloudflare/workers-tsconfig": "link:../../workers-sdk/packages/workers-tsconfig",
		"@cloudflare/workers-types": "5.20261023.1",
		"@cloudflare/workers-utils": "link:../../workers-sdk/packages/workers-utils",
		"@rsbuild/core": "^2.2.14",
		"@types/node": "22.15.17",
		"cf": "1.0.0-beta.17",
		"get-port": "^7.2.0",
		"picocolors": "^1.1.1",
		"tsdown": "0.16.3",
		"typescript": "5.8.3",
		"vitest": "5.0.4"
	},
	"peerDependencies": {
		"@rsbuild/core": "^2.2.10"
	}
}
