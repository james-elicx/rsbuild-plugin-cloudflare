{
	"name": "rsbuild-plugin-cloudflare-test-harness",
	"version": "0.0.0",
	"private": true,
	"description": "Runs the Vite plugin's playground and e2e suites against the Rsbuild plugin",
	"type": "module",
	"scripts": {
		"check:type": "tsc",
		"playwright:install": "pnpm -C ../../workers-sdk/packages/vite-plugin-cloudflare/playground playwright:install",
		"test:e2e": "cd ../../workers-sdk/packages/vite-plugin-cloudflare/e2e && vitest run -c ../../../../packages/test-harness/vitest.e2e.config.ts",
		"test:playground": "pnpm test:playground:serve && pnpm test:playground:build",
		"test:playground:build": "cross-env VITE_TEST_BUILD=1 vitest run -c vitest.playground.config.ts",
		"test:playground:serve": "vitest run -c vitest.playground.config.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-utils": "link:../../workers-sdk/packages/workers-utils",
		"@rsbuild/core": "^2.2.13",
		"@rsbuild/plugin-basic-ssl": "^2.0.0",
		"@rsbuild/plugin-react": "^2.1.1",
		"@types/node": "22.15.17",
		"cross-env": "7.0.3",
		"rsbuild-plugin-cloudflare": "workspace:*",
		"typescript": "5.8.3",
		"vite": "link:../../workers-sdk/packages/vite-plugin-cloudflare/node_modules/vite",
		"vitest": "link:../../workers-sdk/node_modules/vitest"
	}
}
